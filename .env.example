# Copy to .env and fill in. Platforms with missing credentials report "failed" (the others still post).

# Telegram: create a bot with @BotFather, add it as admin of a PUBLIC channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@your_public_channel

# Discord: Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=
DISCORD_GUILD_ID=            # optional, used to build the message link

# Mastodon: Preferences -> Development -> New application (scope write:statuses)
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky: Settings -> App Passwords
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# Dev.to: Settings -> Extensions -> Generate API key
DEVTO_API_KEY=

# Optional: override API base URLs (used by run_demo.sh to target the local mock)
# TELEGRAM_API_BASE=
# BLUESKY_PDS=
# DEVTO_API_BASE=
